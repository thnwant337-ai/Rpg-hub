-- 4. ระบบฟังก์ชันฟาร์มไข่อัตโนมัติ (Egg Farm Logic)
-- ==========================================
local isFarming = false
local startPosition = nil

tfSwitchBtn.MouseButton1Click:Connect(function()
	isFarming = not isFarming
	if isFarming then
		tfSwitchBtn.Text = "ON"
		tfSwitchBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			startPosition = LocalPlayer.Character.HumanoidRootPart.CFrame
		end
	else
		tfSwitchBtn.Text = "OFF"
		tfSwitchBtn.BackgroundColor3 = Color3.fromRGB(70, 75, 85)
	end
end)

-- ฟังก์ชันเช็คว่าไข่อยู่ในโซนบ้านหรือสิ่งก่อสร้างของผู้เล่นหรือไม่
local function isInHouse(targetPart)
	local current = targetPart.Parent
	while current and current ~= Workspace do
		local nameLower = string.lower(current.Name)
		-- ตรวจจับคำค้นหาที่เกี่ยวข้องกับบ้าน แปลง หรือฐานของผู้เล่น
		if nameLower:find("house") or nameLower:find("home") or nameLower:find("plot") or nameLower:find("base") or nameLower:find("interior") or nameLower:find("room") then
			return true
		end
		current = current.Parent
	end
	return false
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if isFarming then
			local character = LocalPlayer.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				local hrp = character.HumanoidRootPart
				
				if not startPosition then
					startPosition = hrp.CFrame
				end
				
				for _, obj in ipairs(Workspace:GetDescendants()) do
					if not isFarming then break end
					
					local eggFoundName = nil
					for _, nameCheck in ipairs(eggTypes) do
						if eggToggles[nameCheck] and (obj.Name == nameCheck or string.find(obj.Name, nameCheck)) then
							eggFoundName = nameCheck
							break
						end
					end
					
					if eggFoundName then
						local targetPart = nil
						if obj:IsA("Model") then
							targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
						elseif obj:IsA("BasePart") then
							targetPart = obj
						end
						
						-- เช็คเงื่อนไข: ต้องมีตัวตน และไม่อยู่ในบ้าน
						if targetPart and not isInHouse(targetPart) then
							local distance = (hrp.Position - targetPart.Position).Magnitude
							local speed = 450
							local travelTime = distance / speed
							
							-- บินไปหาไข่
							local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)})
							tween:Play()
							tween.Completed:Wait()
							
							-- กดปุ่ม E ค้างไว้ 1.5 วินาที
							VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
							task.wait(1.5)
							VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
							task.wait(0.2)
							
							-- กลับจุดเริ่มต้นทันที
							local returnDist = (hrp.Position - startPosition.Position).Magnitude
							local returnTime = returnDist / speed
							local returnTween = TweenService:Create(hrp, TweenInfo.new(returnTime, Enum.EasingStyle.Linear), {CFrame = startPosition})
							returnTween:Play()
							returnTween.Completed:Wait()
							
							task.wait(0.3)
						end
					end
				end
			end
		end
	end
end)

