-- ระบบคลิกเปิด/ปิด UI (ป้องกันตอนลากแล้วหน้าต่างเปิด/ปิดเอง)
local isDraggingToggle = false
local toggleDragStart, toggleStartPos

ToggleButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingToggle = false
		toggleDragStart = input.Position
		toggleStartPos = ToggleButton.Position
	end
end)

ToggleButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		if toggleDragStart and (input.Position - toggleDragStart).Magnitude > 5 then
			isDraggingToggle = true
			local delta = input.Position - toggleDragStart
			ToggleButton.Position = UDim2.new(toggleStartPos.X.Scale, toggleStartPos.X.Offset + delta.X, toggleStartPos.Y.Scale, toggleStartPos.Y.Offset + delta.Y)
		end
	end
end)

ToggleButton.MouseButton1Click:Connect(function()
	if not isDraggingToggle then
		MainFrame.Visible = not MainFrame.Visible
	end
end)

-- 6. ระบบลากย้ายหน้าต่างหลัก (Drag System)
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- 7. ระบบขยายขนาด (Resize) มุมขวาล่าง
local ResizeButton = Instance.new("TextButton")
ResizeButton.Size = UDim2.new(0, 16, 0, 16)
ResizeButton.Position = UDim2.new(1, -16, 1, -16)
