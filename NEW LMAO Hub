-- ระบบอัปเดต FPS และ Ping แบบเรียลไทม์
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local lastUpdate = 0
local frameCount = 0
local currentFPS = 0

RunService.RenderStepped:Connect(function(dt)
	frameCount = frameCount + 1
	lastUpdate = lastUpdate + dt
	if lastUpdate >= 1 then
		currentFPS = math.floor(frameCount / lastUpdate)
		frameCount = 0
		lastUpdate = 0
	end
end)

task.spawn(function()
	while task.wait(0.5) do
		local success, pingVal = pcall(function()
			return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		local pingText = success and (pingVal .. " ms") or "N/A"
		
		ContentDesc.Text = "👤 ชื่อตัวละคร (Display): " .. displayName ..
						   "\n🆔 ชื่อผู้ใช้ (Username): @" .. userName ..
						   "\n🌐 ปิง (Ping): " .. pingText ..
						   "\n⚡ เฟรมเรต (FPS): " .. currentFPS .. " FPS"
	end
end)

